{
	"name": "morigerati",
	"version": "1.0.0",
	"description": "Transluoghi ecomuseo website (Payload + Next.js)",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
		"lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"test": "pnpm run test:int && pnpm run test:e2e",
		"test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
		"test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
		"compose:up": "docker compose -f docker-compose.dev.yml up",
		"compose:down": "docker compose -f docker-compose.dev.yml down -v",
		"db:clear": "pnpm payload run src/db/seed/db-clear.ts",
		"db:seed": "pnpm payload run src/db/seed/db-seed.ts",
		"social:clear": "pnpm payload run src/db/seed/social/social-clear.ts",
		"social:seed": "pnpm payload run src/db/seed/social/social-seed.ts"
	},
	"dependencies": {
		"@payloadcms/db-mongodb": "3.91.0",
		"@payloadcms/db-postgres": "3.91.0",
		"@payloadcms/next": "3.91.0",
		"@payloadcms/payload-cloud": "3.91.0",
		"@payloadcms/plugin-seo": "3.91.0",
		"@payloadcms/richtext-lexical": "3.91.0",
		"@payloadcms/sdk": "3.91.0",
		"@payloadcms/storage-s3": "3.91.0",
		"@payloadcms/translations": "3.91.0",
		"@payloadcms/ui": "3.91.0",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-visually-hidden": "^1.2.3",
		"@tailwindcss/postcss": "^4.1.16",
		"@types/leaflet-gpx": "^1.3.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cross-env": "^7.0.3",
		"date-fns": "^4.1.0",
		"dotenv": "16.4.7",
		"effect": "^3.18.4",
		"eslint-plugin-perfectionist": "^4.15.1",
		"file-type": "^21.3.4",
		"graphql": "^16.8.1",
		"leaflet": "^1.9.4",
		"leaflet-defaulticon-compatibility": "^0.1.2",
		"leaflet-gpx": "^2.2.0",
		"lucide-react": "^0.552.0",
		"markdown-to-txt": "^2.0.1",
		"nanoid": "^5.1.6",
		"next": "16.4.2",
		"next-intl": "^4.4.0",
		"next-safe-action": "^8.0.11",
		"payload": "3.91.0",
		"postcss": "^8.5.6",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-infinite-scroll-hook": "^6.0.1",
		"react-leaflet": "^5.0.0",
		"react-photo-album": "^3.2.1",
		"sharp": "0.35.5",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.16",
		"type-fest": "^5.2.0",
		"yet-another-react-lightbox": "^3.25.0",
		"zod": "^4.1.12",
		"zod-form-data": "^3.0.1"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.1.0",
		"@next/eslint-plugin-next": "16.4.2",
		"@playwright/test": "1.54.1",
		"@tailwindcss/typography": "^0.5.19",
		"@testing-library/react": "16.3.0",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^22.5.4",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"@vitejs/plugin-react": "4.5.2",
		"eslint": "^9.16.0",
		"eslint-config-next": "16.4.2",
		"eslint-plugin-react-hooks": "^7.0.1",
		"jsdom": "26.1.0",
		"playwright": "1.54.1",
		"playwright-core": "1.54.1",
		"prettier": "^3.4.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.7.3",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.3"
	},
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20.18.1",
		"pnpm": "^9 || ^10 || ^11"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp",
			"esbuild",
			"unrs-resolver"
		]
	}
}
